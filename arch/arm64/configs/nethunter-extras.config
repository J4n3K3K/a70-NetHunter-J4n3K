#
# NetHunter extras for Samsung Galaxy A70 (a70q / SM-A705F / SM-A705FN)
# Merged on top of the base defconfig by build_nethunter.sh:
#   scripts/kconfig/merge_config.sh <base_defconfig> nethunter-extras.config
#
# Everything that can be built-in is =y (no module loading needed).
# Only drivers that clash with built-in ones are =m.
#

CONFIG_LOCALVERSION="-NetHunter-J4n3K"
# CONFIG_LOCALVERSION_AUTO is not set

# ---------------------------------------------------------------------------
# Samsung security: allow loading our own kernel modules (.ko)
# UH_LKM_BLOCK rejects *every* module unconditionally.
# ---------------------------------------------------------------------------
# CONFIG_UH_LKMAUTH is not set
# CONFIG_UH_LKM_BLOCK is not set
# CONFIG_SECURITY_DEFEX is not set
# CONFIG_PROCA is not set
# CONFIG_FIVE is not set
# CONFIG_MODULE_SIG is not set
# CONFIG_MODULE_SIG_FORCE is not set
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_MODULE_FORCE_LOAD=y
CONFIG_MODULE_FORCE_UNLOAD=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_KALLSYMS=y
CONFIG_KALLSYMS_ALL=y

# ---------------------------------------------------------------------------
# CARsenal: CAN bus / SocketCAN
# ---------------------------------------------------------------------------
CONFIG_CAN=y
CONFIG_CAN_RAW=y
CONFIG_CAN_BCM=y
CONFIG_CAN_GW=y
CONFIG_CAN_ISOTP=y
CONFIG_CAN_VCAN=y
CONFIG_CAN_VXCAN=y
CONFIG_CAN_SLCAN=y
CONFIG_CAN_DEV=y
CONFIG_CAN_CALC_BITTIMING=y
# USB <-> CAN adapters
CONFIG_CAN_GS_USB=y
CONFIG_CAN_PEAK_USB=y
CONFIG_CAN_KVASER_USB=y
CONFIG_CAN_EMS_USB=y
CONFIG_CAN_ESD_USB2=y
CONFIG_CAN_8DEV_USB=y
CONFIG_CAN_MCBA_USB=y
# CONFIG_CAN_DEBUG_DEVICES is not set

# ---------------------------------------------------------------------------
# CARsenal / hardware hacking: USB serial (ELM327, OBD-II, slcan, CANable
# in slcan mode, USB-UART, Arduino, Flipper, Proxmark, GPS ...)
# ---------------------------------------------------------------------------
CONFIG_USB_SERIAL=y
CONFIG_USB_SERIAL_GENERIC=y
CONFIG_USB_SERIAL_SIMPLE=y
CONFIG_USB_SERIAL_FTDI_SIO=y
CONFIG_USB_SERIAL_PL2303=y
CONFIG_USB_SERIAL_CH341=y
CONFIG_USB_SERIAL_CP210X=y
CONFIG_USB_SERIAL_CYPRESS_M8=y
CONFIG_USB_SERIAL_ARK3116=y
CONFIG_USB_SERIAL_OPTION=y
CONFIG_USB_SERIAL_QUALCOMM=y
CONFIG_USB_SERIAL_WWAN=y
CONFIG_USB_SERIAL_F81232=y
CONFIG_USB_SERIAL_MCT_U232=y
CONFIG_USB_SERIAL_TI=y
CONFIG_USB_ACM=y

# ---------------------------------------------------------------------------
# Bluetooth (external dongles, BT ELM327, HID attacks over BT)
# ---------------------------------------------------------------------------
CONFIG_BT=y
CONFIG_BT_RFCOMM=y
CONFIG_BT_RFCOMM_TTY=y
CONFIG_BT_BNEP=y
CONFIG_BT_BNEP_MC_FILTER=y
CONFIG_BT_BNEP_PROTO_FILTER=y
CONFIG_BT_HIDP=y
CONFIG_BT_HCIBTUSB=y
CONFIG_BT_HCIBTUSB_BCM=y
CONFIG_BT_HCIBTUSB_RTL=y
CONFIG_BT_HCIUART=y
CONFIG_BT_HCIUART_H4=y
CONFIG_BT_HCIUART_BCSP=y
CONFIG_BT_HCIUART_ATH3K=y
CONFIG_BT_HCIBCM203X=y
CONFIG_BT_HCIBPA10X=y
CONFIG_BT_HCIBFUSB=y
CONFIG_BT_HCIVHCI=y
CONFIG_BT_ATH3K=y

# ---------------------------------------------------------------------------
# External Wi-Fi (monitor mode / injection)
# ---------------------------------------------------------------------------
CONFIG_CFG80211_WEXT=y
CONFIG_MAC80211=y
CONFIG_MAC80211_MESH=y
CONFIG_ATH9K_HTC=y
CONFIG_CARL9170=y
CONFIG_AR5523=y
CONFIG_RT2X00=y
CONFIG_RT2500USB=y
CONFIG_RT73USB=y
CONFIG_RT2800USB=y
CONFIG_RT2800USB_RT33XX=y
CONFIG_RT2800USB_RT35XX=y
CONFIG_RT2800USB_RT3573=y
CONFIG_RT2800USB_RT53XX=y
CONFIG_RT2800USB_RT55XX=y
CONFIG_RT2800USB_UNKNOWN=y
CONFIG_RTL8187=y
CONFIG_RTL8XXXU=y
CONFIG_RTL8XXXU_UNTESTED=y
CONFIG_MT7601U=y
CONFIG_ZD1211RW=y
CONFIG_P54_COMMON=y
CONFIG_P54_USB=y
CONFIG_USB_NET_RNDIS_WLAN=y
# Realtek aircrack-ng drivers
CONFIG_STAGING=y
CONFIG_88XXAU=y
CONFIG_RTL8188EUS=m

# ---------------------------------------------------------------------------
# USB Ethernet / tethering adapters
# ---------------------------------------------------------------------------
CONFIG_USB_USBNET=y
CONFIG_USB_NET_AX8817X=y
CONFIG_USB_NET_AX88179_178A=y
CONFIG_USB_NET_CDCETHER=y
CONFIG_USB_NET_CDC_EEM=y
CONFIG_USB_NET_CDC_NCM=y
CONFIG_USB_NET_CDC_SUBSET=y
CONFIG_USB_NET_RNDIS_HOST=y
CONFIG_USB_NET_DM9601=y
CONFIG_USB_NET_SMSC75XX=y
CONFIG_USB_NET_SMSC95XX=y
CONFIG_USB_NET_MCS7830=y
CONFIG_USB_NET_NET1080=y
CONFIG_USB_NET_ZAURUS=y
CONFIG_USB_RTL8150=y
CONFIG_USB_RTL8152=y
CONFIG_USB_LAN78XX=y
CONFIG_USB_IPHETH=y

# ---------------------------------------------------------------------------
# USB Arsenal (gadget): HID keyboard/mouse, RNDIS, ECM, ACM, mass storage
# ---------------------------------------------------------------------------
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_F_HID=y
CONFIG_USB_CONFIGFS_RNDIS=y
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_USB_CONFIGFS_EEM=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_CONFIGFS_SERIAL=y
CONFIG_USB_CONFIGFS_MASS_STORAGE=y
CONFIG_USB_CONFIGFS_F_FS=y

# HID host side
CONFIG_HID=y
CONFIG_HIDRAW=y
CONFIG_UHID=y
CONFIG_USB_HID=y
CONFIG_USB_HIDDEV=y

# ---------------------------------------------------------------------------
# Networking for MITM, tunnels, containers
# ---------------------------------------------------------------------------
CONFIG_TUN=y
CONFIG_VETH=y
CONFIG_DUMMY=y
CONFIG_MACVLAN=y
CONFIG_MACVTAP=y
CONFIG_VLAN_8021Q=y
CONFIG_BRIDGE=y
CONFIG_NET_IPGRE_DEMUX=y
CONFIG_NET_IPGRE=y
CONFIG_NET_IPIP=y
CONFIG_IPV6_SIT=y
CONFIG_NETFILTER_XT_TARGET_TPROXY=y
CONFIG_NETFILTER_XT_MATCH_SOCKET=y
CONFIG_IP_NF_TARGET_MASQUERADE=y
CONFIG_IP_NF_TARGET_REDIRECT=y
CONFIG_IP6_NF_NAT=y
CONFIG_IP6_NF_TARGET_MASQUERADE=y
CONFIG_PACKET=y
CONFIG_PACKET_DIAG=y
CONFIG_UNIX_DIAG=y
CONFIG_INET_DIAG=y

# Chroot / containers / qemu-user
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_BINFMT_MISC=y
CONFIG_OVERLAY_FS=y
CONFIG_FUSE_FS=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_SQUASHFS=y
CONFIG_ISO9660_FS=y
CONFIG_UDF_FS=y

# USB storage
CONFIG_USB_STORAGE=y
CONFIG_USB_UAS=y
