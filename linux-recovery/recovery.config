#
# Linux-recovery kernel: nethunter-extras.config + this fragment
# Used by build_linux_recovery.sh (kernel goes to the RECOVERY partition).
#
CONFIG_LOCALVERSION="-LinuxRecovery-J4n3K"

# initramfs userspace
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_CONFIGFS_FS=y

# Root filesystems (loop image on userdata or a microSD partition)
CONFIG_BLK_DEV_LOOP=y
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_F2FS_FS=y
CONFIG_VFAT_FS=y
CONFIG_MMC_BLOCK=y

# What systemd / regular distros expect
CONFIG_FHANDLE=y
CONFIG_AUTOFS4_FS=y
CONFIG_CGROUPS=y
CONFIG_INOTIFY_USER=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EPOLL=y
CONFIG_SECCOMP=y
CONFIG_UNIX=y
CONFIG_IPV6=y
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
CONFIG_NLS_ASCII=y
CONFIG_NLS_UTF8=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y

# Android-only: limits socket() to Android "inet" groups -> breaks
# every non-root user on a normal distro.
# CONFIG_ANDROID_PARANOID_NETWORK is not set

# USB shell / networking in the initramfs
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_CONFIGFS_ECM=y

# Display: DRM/KMS works in userspace (Wayland/kmscon). fbcon is kept on so
# the log shows up if fbdev emulation ever works on the SDE driver.
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FRAMEBUFFER_CONSOLE=y

# Do not wait 60 s per missing firmware (no Android ueventd here)
# CONFIG_FW_LOADER_USER_HELPER_FALLBACK is not set
